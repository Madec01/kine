# Copier en .env (ou .env.local) pour le développement, et déclarer les mêmes
# variables dans GitHub (Settings → Secrets and variables → Actions) ou Vercel.
#
# Sans ces deux variables, l'application démarre en MODE LOCAL (données dans le
# navigateur uniquement, sans compte ni partage).

# URL du projet Supabase (Project Settings → API)
VITE_SUPABASE_URL=
# Clé « anon » publique du projet (la sécurité repose sur les politiques RLS)
VITE_SUPABASE_ANON_KEY=

# Forcer le mode local même si Supabase est configuré (essais, tests) : local
# VITE_DATA_MODE=

# Chemin de publication (GitHub Pages dans un sous-dossier : /kine/)
# VITE_BASE=/kine/
