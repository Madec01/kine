# Copier en .env (ou .env.local) pour le développement, et déclarer les mêmes
# variables dans GitHub (Settings → Secrets and variables → Actions).
#
# Sans ces variables, l'application fonctionne uniquement sur l'appareil
# (IndexedDB) : pas de sauvegarde en ligne ni de synchronisation.

# Configuration web du projet Firebase (Paramètres du projet → Vos applications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Facultatifs
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=

# Chemin de publication (GitHub Pages dans un sous-dossier : /kine/)
# VITE_BASE=/kine/
